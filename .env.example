# 應用程式配置
APP_NAME=ACE服務管理後台
VERSION=1.0.0
DEBUG=True

# JWT 配置 (⚠️ 生產環境務必更換 SECRET_KEY)
SECRET_KEY=your-secret-key-here-please-change-me
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# 資料庫配置
# 開發環境使用 SQLite (預設 - 保留備用)
DATABASE_URL=sqlite:///./admin.db

# 生產環境使用 MySQL (保留備用)
# DATABASE_URL=mysql+pymysql://username:password@hostname:3306/database

# 資料庫連線池配置 (SQLAlchemy - 保留備用)
SQLALCHEMY_MAX_OVERFLOW=29
SQLALCHEMY_WARN_20=1
DATABASE_POOL_CONNECTION_MIN=10
DATABASE_POOL_CONNECTION_MAX_OVERFLOW=30
DATABASE_POOL_CONNECTION_TIMEOUT=30
DATABASE_POOL_CONNECTION_RECYCLE=600

# MongoDB 配置 (主要資料庫)
# 本地開發環境
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB_NAME=tibame_ace_db

# MongoDB Atlas (雲端 - 生產環境)
# MONGODB_URL=mongodb+srv://username:password@cluster.mongodb.net/?retryWrites=true&w=majority
# MONGODB_DB_NAME=tibame_ace_db

# CORS 配置 (生產環境請指定允許的來源)
# BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:8080"]

# LINE 整合 (選用)
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=

# Azure Language 服務 (選用)
AZURE_API_KEY=
AZURE_END_POINT=

# 中央氣象署 API (選用)
CWB_API_TOKEN=
CWB_BASE_URL=https://opendata.cwa.gov.tw/api/v1/rest/datastore

# Ollama 本地 LLM (選用)
# 支援模型: gpt-oss:latest / gemma3:latest / gemma3n:latest / gemma3:12b / llama3.1:latest / llama3.2:latest
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=gpt-oss:latest
