# 應用程式配置
APP_NAME=ACE服務管理後台
VERSION=1.0.0
DEBUG=True

# JWT 配置
SECRET_KEY=ABCDEFGHIJKLMNOPQRSTUVWXYZ123456
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# 資料庫配置 (暫時使用 SQLite 進行測試)
# DATABASE_URL=sqlite:///./admin.db
DATABASE_URL=mysql+pymysql://user:password@localhost:3306/dbname
SQLALCHEMY_MAX_OVERFLOW=29
SQLALCHEMY_WARN_20=1
DATABASE_POOL_CONNECTION_MIN=10
DATABASE_POOL_CONNECTION_MAX_OVERFLOW=30
DATABASE_POOL_CONNECTION_TIMEOUT=30
DATABASE_POOL_CONNECTION_RECYCLE=600

# 使用 PostgreSQL 範例: DATABASE_URL=postgresql://user:password@localhost/dbname
# 使用 MySQL 範例: DATABASE_URL=mysql+pymysql://user:password@localhost/dbname

