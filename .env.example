# 應用程式配置
APP_NAME=ACE服務管理後台
VERSION=1.0.0
DEBUG=True

# JWT 配置
SECRET_KEY=your-secret-key-here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# 資料庫配置
# SQLite: sqlite:///./admin.db
DATABASE_URL=mysql+pymysql://user:password@localhost:3306/dbname

# 資料庫連接池配置
SQLALCHEMY_MAX_OVERFLOW=29
SQLALCHEMY_WARN_20=1
DATABASE_POOL_CONNECTION_MIN=10
DATABASE_POOL_CONNECTION_MAX_OVERFLOW=30
DATABASE_POOL_CONNECTION_TIMEOUT=30
DATABASE_POOL_CONNECTION_RECYCLE=600

# MongoDB 配置
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB_NAME=tibame_ace_db

# CORS 配置
BACKEND_CORS_ORIGINS=["*"]

# LINE Bot 配置 (通用)
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=

# LINE Bot 部門配置
# GS - 客務部
GS_ACCESS_TOKEN=
GS_SECRET=

# HK - 房務部
HK_ACCESS_TOKEN=
HK_SECRET=

# CON - 門房諮詢
CON_ACCESS_TOKEN=
CON_SECRET=

# BP - 烘焙點心房
BP_ACCESS_TOKEN=
BP_SECRET=

# FB - 餐飲
FB_ACCESS_TOKEN=
FB_SECRET=

# CBS - 會議宴會
CBS_ACCESS_TOKEN=
CBS_SECRET=

# FS - 花房
FS_ACCESS_TOKEN=
FS_SECRET=

# LUR - 洗衣房與制服室
LUR_ACCESS_TOKEN=
LUR_SECRET=

# GAE - 總務工程
GAE_ACCESS_TOKEN=
GAE_SECRET=

# BB - 飲料酒吧
BB_ACCESS_TOKEN=
BB_SECRET=

# AD - 美術設計
AD_ACCESS_TOKEN=
AD_SECRET=

# LA - 休閒活動部
LA_ACCESS_TOKEN=
LA_SECRET=

# Azure Language 配置
AZURE_API_KEY=
AZURE_END_POINT=

# Azure Speech-to-Text 配置
AZURE_SPEECH_API_KEY=
AZURE_SPEECH_ENDPOINT=
AZURE_SPEECH_REGION=eastus

# AWS 配置 (用於情感分析)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1

# CWB (氣象局) 配置
CWB_API_TOKEN=
CWB_BASE_URL=https://opendata.cwa.gov.tw/api/v1/rest/datastore

# Ollama 配置
# 模型選項: gpt-oss:latest / gemma3:latest / gemma3n:latest / gemma3:12b / llama3.1:latest / llama3.2:latest
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=gpt-oss:latest

# Google LLM 配置
ADK_BASE_URL=https://llm.89.com.tw
ADK_APP_NAME=agents
