{
  "type": "bubble",
  "size": "mega",
  "header": {
    "type": "box",
    "layout": "vertical",
    "contents": [
      {
        "type": "box",
        "layout": "horizontal",
        "contents": [
          {
            "type": "text",
            "text": "HK 房務部",
            "color": "#B4B4B4",
            "weight": "bold",
            "size": "xs",
            "gravity": "center",
            "flex": 1
          },
          {
            "type": "text",
            "text": "Room 1205",
            "weight": "bold",
            "size": "lg",
            "color": "#FFFFFF",
            "gravity": "center",
            "align": "end",
            "flex": 1
          }
        ]
      }
    ],
    "backgroundColor": "#1A3B5D",
    "paddingAll": "20px"
  },
  "body": {
    "type": "box",
    "layout": "vertical",
    "contents": [
      {
        "type": "text",
        "text": "任務回報 (1/5)",
        "weight": "bold",
        "size": "xs",
        "color": "#C5A065"
      },
      {
        "type": "text",
        "text": "是否順利完成？",
        "weight": "bold",
        "size": "xl",
        "color": "#1A3B5D",
        "margin": "md"
      },
      {
        "type": "text",
        "text": "請確認現場狀況是否符合驗收標準。",
        "size": "sm",
        "color": "#aaaaaa",
        "margin": "sm",
        "wrap": true
      }
    ],
    "paddingAll": "20px"
  },
  "footer": {
    "type": "box",
    "layout": "horizontal",
    "contents": [
      {
        "type": "button",
        "action": {
          "type": "postback",
          "label": "是 (Yes)",
          "data": "action=report_step1&result=yes"
        },
        "style": "primary",
        "color": "#188038",
        "height": "sm"
      },
      {
        "type": "separator",
        "margin": "md"
      },
      {
        "type": "button",
        "action": {
          "type": "postback",
          "label": "否 (No)",
          "data": "action=report_step1&result=no"
        },
        "style": "primary",
        "color": "#D93025",
        "margin": "md",
        "height": "sm"
      }
    ],
    "paddingAll": "20px"
  }
}